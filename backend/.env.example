# Konfigurasi Database E-Pangan

# Opsi 1: SQLite (Standar / Tanpa server XAMPP)
DATABASE_URL=sqlite:///./epangan.db

# Opsi 2: MySQL (Jika menggunakan MySQL lokal / server mandiri)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/epangan_db

# Opsi 3: PostgreSQL (Jika menggunakan PostgreSQL / Cloud Database seperti Supabase / Neon)
# DATABASE_URL=postgresql://user:password@localhost:5432/epangan_db
